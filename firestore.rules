rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // İpek'in Çiftliği 2.5D: her oyuncu sadece kendi kaydını okur ve yazar
    match /ciftlikler/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['save', 'updatedAt', 'v', 'name', 'farm'])
        && request.resource.data.save is string
        && request.resource.data.save.size() < 900000
        && request.resource.data.updatedAt is int
        && request.resource.data.name is string && request.resource.data.name.size() <= 20
        && request.resource.data.farm is string && request.resource.data.farm.size() <= 24;
    }

    // Eski oyun (index_7) çalışmaya devam etsin diye; yeni oyun da kurallar yüklenmemişse buraya (ipek25d alanına) yedek kaydeder
    match /farms/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /leaderboard/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // İletişim formu: herkes yeni mesaj bırakabilir, kimse okuyamaz (Firebase Console'dan okunur)
    match /mesajlar/{id} {
      allow create: if request.resource.data.keys().hasOnly(['ad', 'eposta', 'konu', 'mesaj', 'at', 'sayfa'])
        && request.resource.data.ad is string && request.resource.data.ad.size() >= 2 && request.resource.data.ad.size() <= 60
        && request.resource.data.eposta is string && request.resource.data.eposta.size() <= 120
        && request.resource.data.mesaj is string && request.resource.data.mesaj.size() >= 10 && request.resource.data.mesaj.size() <= 2000
        && request.resource.data.konu is string && request.resource.data.konu.size() <= 40
        && request.resource.data.at is int;
      allow read, update, delete: if false;
    }

    // Geri kalan her şey kapalı
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
